{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "web": {
      "root": "apps/web",
      "framework": "vite",
      "installCommand": "cd ../.. && npm install",
      "buildCommand": "npm run build",
      "outputDirectory": "../../dist/web"
    },
    "api": {
      "root": "apps/api",
      "framework": "express",
      "entrypoint": "src/server.ts",
      "installCommand": "cd ../.. && npm install"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": { "service": "api" }
    },
    {
      "source": "/(.*)",
      "destination": { "service": "web" }
    }
  ]
}
