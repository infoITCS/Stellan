{
  "name": "@stellan/web",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build:client": "vite build --config vite.config.ts",
    "build:server": "vite build --ssr src/entry-server.tsx --config vite.config.ts",
    "generate": "node scripts/generate.mjs",
    "build": "npm run build:client && npm run build:server && npm run generate",
    "preview": "vite preview --host 0.0.0.0 --config vite.config.ts",
    "lint": "node scripts/lint.mjs",
    "typecheck": "tsc --project tsconfig.json --noEmit",
    "test": "node --test --experimental-strip-types tests/*.test.ts",
    "verify:build": "npm run build && npm run test"
  },
  "dependencies": {
    "@fontsource-variable/outfit": "^5.3.0",
    "@fontsource/poppins": "^5.3.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^5.0.0",
    "typescript": "^5.8.3",
    "vite": "^7.0.0"
  }
}
